# ============================================================
#  Farmer AI � Environment Template
#  Copy this to .env and fill in your actual values.
#  NEVER commit the real .env to version control!
# ============================================================

# Flask Secret Key (generate a strong random string for production)
SECRET_KEY=your_strong_random_secret_key_here

# Gemini API key (server-side only; never expose this in React or Vite)
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Runtime
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_PORT=5000

# Database
DB_PATH=database/farmer.db

# File Uploads
UPLOAD_FOLDER=static/uploads

# Demo Account Credentials (for seeding only � remove in production)
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=changeme123
DEMO_USER_NAME=Demo User
DEMO_USER_LOCATION=Telangana
DEMO_USER_LANGUAGE=te

# ML Model Paths
CROP_MODEL_PATH=models/crop_model.pkl
DISEASE_MODEL_PATH=models/disease_model.pkl

# CORS (comma-separated allowed origins, * = all)
# Use the deployed frontend origin(s), comma-separated. Do not use * with sessions.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Vite frontend API URL. Use the deployed Flask URL when frontend and backend are separate.
VITE_API_BASE_URL=https://your-farmer-ai-backend.example.com

# Vite-only local proxy target. This is not included in the production frontend bundle.
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:5000
