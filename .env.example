# ============================================================
#  Farmer AI — Environment Template
#  Copy this to .env and fill in your actual values.
#  NEVER commit the real .env to version control!
# ============================================================

# Flask Secret Key (generate a strong random string for production)
SECRET_KEY=your_strong_random_secret_key_here

# Flask Runtime
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_PORT=5000

# Database
DB_PATH=database/farmer.db

# File Uploads
UPLOAD_FOLDER=static/uploads

# Demo Account Credentials (for seeding only — remove in production)
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=changeme123
DEMO_USER_NAME=Demo User
DEMO_USER_LOCATION=Telangana
DEMO_USER_LANGUAGE=te

# ML Model Paths
CROP_MODEL_PATH=models/crop_model.pkl
DISEASE_MODEL_PATH=models/disease_model.pkl

# CORS (comma-separated allowed origins, * = all)
CORS_ALLOWED_ORIGINS=*
